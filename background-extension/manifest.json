{
  "manifest_version": 3,
  "name": "Joybuy Background Page Collector",
  "description": "Fetches Joybuy listing pages in the background and records product prices.",
  "version": "0.1.0",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://joybuy.de/*",
    "https://www.joybuy.de/*",
    "https://*.joybuy.de/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Joybuy background collection",
    "default_popup": "popup.html"
  }
}

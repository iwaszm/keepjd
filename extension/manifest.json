{
  "manifest_version": 3,
  "name": "Joybuy Price History Tracker",
  "description": "Shows lightweight historical price charts on joybuy.de product pages.",
  "version": "0.1.0",
  "permissions": [
    "alarms"
  ],
  "host_permissions": [
    "https://joybuy.de/*",
    "https://www.joybuy.de/*",
    "https://*.joybuy.de/*",
    "https://*.workers.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://joybuy.de/*",
        "https://www.joybuy.de/*",
        "https://*.joybuy.de/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
